    "start": "node server/server.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "mathjs": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "esbuild": "^0.21.5"
  }
}